FROM golang:alpine3.21 AS build
RUN apk add build-base git
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
# Preserve the Go dependency build cache in a layer shared by release builds.
RUN CGO_ENABLED=1 go build -tags "sqlite_foreign_keys sqlite_json" ./vendor/...
COPY . .
RUN make host

FROM alpine:latest
RUN apk add --no-cache ca-certificates && update-ca-certificates
COPY --from=build /src/out/yarr /usr/local/bin/yarr
EXPOSE 7070
ENTRYPOINT ["/usr/local/bin/yarr"]
CMD ["-addr", "0.0.0.0:7070", "-db", "/data/yarr.db"]
